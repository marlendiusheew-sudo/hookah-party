<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Экран запуска: тёмный фон и логотип, как у сайта. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
	</dict>
	<!-- Адрес сервера Hookah Party (https://…). Пусто — приложение работает с сайтом внутри себя, в демо-режиме. -->
	<key>HPServerURL</key>
	<string></string>
	<!-- Открывать ссылки на карты в приложениях Google Maps и 2ГИС, если они установлены. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>comgooglemaps</string>
		<string>dgis</string>
	</array>
</dict>
</plist>
