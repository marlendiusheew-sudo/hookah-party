# Скопируйте в .env и заполните. Файл .env не попадает в репозиторий.
# Храните копию .env (DATA_KEY, BACKUP_KEY, ADMIN_CODE_KEY) вне сервера, например в менеджере паролей:
# без DATA_KEY не прочитать номера, без BACKUP_KEY — резервные копии. Пошаговый запуск сервера — deploy/SERVER-SETUP.md.
PORT=3000
# production — без показа кода из SMS на экране, cookie только по HTTPS
NODE_ENV=development
# 32 байта в base64 для шифрования номеров: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Сменить ключ (например, если он мог утечь) — только командой node server/rotate-key.js при остановленном сервере:
# она перешифрует базу и сама заменит эту строку. Просто вписать сюда новый ключ нельзя — номера перестанут читаться.
DATA_KEY=
# Путь к базе SQLite
DB_PATH=server/data/hookah.db
# Демо-данные в пустой базе (тестовые пользователи с паролем hookah). На настоящем сервере обязательно SEED=0.
# SEED=0
# 1, если сервер стоит за nginx/Cloudflare и IP нужно брать из X-Forwarded-For
TRUST_PROXY=0
# Отправка SMS: dev (код в журнале сервера) | nikita | twilio
SMS_PROVIDER=dev
NIKITA_LOGIN=
NIKITA_PASSWORD=
NIKITA_SENDER=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
# Коды стран, с номерами которых можно зарегистрироваться и войти по SMS (через запятую). На другие номера SMS не уходят.
ALLOWED_PHONE_PREFIXES=996
# Бюджет SMS на весь сервер: в час и в сутки. С 80% суточного — сигнал администратору, на 100% отправка встаёт до освобождения окна.
SMS_PER_HOUR=60
SMS_PER_DAY=300

# Администратор — только владелец. Номер(а) через запятую, например +996700123456
ADMIN_PHONES=
# Ключ шифрования кода панели администратора: node server/admin.js key (создаётся один раз, хранить в тайне)
ADMIN_CODE_KEY=

# Резервные копии (node server/backup.js, на сервере — каждую ночь). Копия шифруется ключом BACKUP_KEY:
# создать его — node server/backup.js key (один раз; команда сама впишет ключ сюда, на экран он не выводится).
BACKUP_KEY=
# Папка для копий и сколько последних копий хранить
BACKUP_DIR=server/data/backups
BACKUP_KEEP=14
