{
  "name": "hookah-party",
  "version": "1.0.0",
  "private": true,
  "description": "Hookah Party — приглашения на кальянные сборы в Бишкеке (сайт + сервер без сторонних зависимостей)",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node tests/smoke.test.js && node tests/xss.test.js && node --test tests/server.test.js tests/attack.test.js tests/deploy.test.js",
    "test:e2e": "node --test tests/e2e.test.js",
    "test:security": "node tests/xss.test.js && node --test tests/attack.test.js",
    "secrets": "node scripts/check-secrets.js --all",
    "secrets:history": "node scripts/check-secrets.js --history",
    "hooks": "git config core.hooksPath .githooks",
    "backup": "node server/backup.js",
    "restore": "node server/backup.js restore",
    "rotate-key": "node server/rotate-key.js"
  },
  "devDependencies": {
    "jsdom": "30.1.3",
    "playwright": "1.64.1"
  },
  "engines": {
    "node": ">=24.7"
  }
}
